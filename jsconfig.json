{
  "compilerOptions": {
    "baseUrl": "./src/scripts",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["*"],
      "components/*": ["components/*"],
      "core/*": ["core/*"],
      "data/*": ["data/*"],
      "helpers/*": ["helpers/*"],
      "state/*": ["state/*"]
    },
    "target": "ES2022",
    "checkJs": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true
  },
  "exclude": ["node_modules", "dist", ".parcel-cache"]
}
